# CloudPulse configuration — NON-SECRET values only.
# Never put AWS access keys here. Keys live in the AWS credential chain
# (~/.aws/credentials via `aws configure --profile <name>`) or an IAM role on EC2.
# Copy to .env and/or set the same variables in your shell.

CLOUDPULSE_PROFILE=cloudpulse
CLOUDPULSE_REGION=ap-south-1
CLOUDPULSE_INSTANCE_ID=i-0123456789abcdef0
CLOUDPULSE_HISTORY_HOURS=6
CLOUDPULSE_METRIC_STATISTIC=Average

# Read-only metrics role uses cloudpulse profile; live scaling uses a SEPARATE profile:
CLOUDPULSE_SCALING_PROFILE=cloudpulse-scaler

# Controller bounds and safety thresholds (doc defaults: min=1, max=2)
CLOUDPULSE_MIN_CAPACITY=1
CLOUDPULSE_MAX_CAPACITY=2
CLOUDPULSE_FALLBACK_CPU_THRESHOLD=85
CLOUDPULSE_ENABLE_LIVE_SCALING=false

# Optional sanity check: fail live changes if caller account differs
CLOUDPULSE_EXPECTED_ACCOUNT_ID=
